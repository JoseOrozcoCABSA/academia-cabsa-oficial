# Entorno de ejecución
NODE_ENV=production
SERVICE_BIND_HOST=0.0.0.0
GATEWAY_BIND_HOST=0.0.0.0

# Base de datos MySQL
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=academia
SOURCE_DB_NAME=academia
DB_USER=academia
DB_PASSWORD=CAMBIAR_DB_PASSWORD
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=10000
DB_POOL_IDLE_MS=10000
DB_POOL_EVICT_MS=1000

# Autenticación y comunicación interna
JWT_SECRET=CAMBIAR_JWT_SECRET
JWT_EXPIRES_IN=8h
INTERNAL_SERVICE_KEY=CAMBIAR_INTERNAL_SERVICE_KEY

# URLs públicas y CORS
CORS_ORIGINS=http://localhost:6007,http://localhost:6008
API_PUBLIC_URL=http://localhost:6080
PORTAL_PUBLIC_URL=http://localhost:6007
FRONTEND_URL=http://localhost:6007

# Puertos
PORT_GATEWAY=6080
PORT_ACADEMIA=6001
PORT_AI=6002
PORT_CONTENT=6003
PORT_ANALYTICS=6004
PORT_USERS=6005
PORT_NOTIFICATIONS=6006
PORT_FRONTEND_ACADEMIA=6007
PORT_FRONTEND_ADMIN=6008

# Red y límites
REQUEST_TIMEOUT_MS=10000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
TRUST_PROXY_HOPS=0
REDIS_URL=

# Correo electrónico
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=Academia CABSA
MAIL_FROM_ADDRESS=

# Archivos multimedia
MEDIA_STORAGE_PATH=runtime-media
MEDIA_MAX_FILE_MB=25

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_DOCKER_URL=http://host.docker.internal:6333
QDRANT_COLLECTION=academia_cabsa

# Copias de seguridad
BACKUP_NAME=academia
BACKUP_DIRECTORY=database-backups
