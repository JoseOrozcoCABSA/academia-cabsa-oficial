{
  "name": "academia-cabsa-api-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:watch": "tsx --test --watch \"src/**/*.test.ts\""
  },
  "imports": {
    "#app": "./dist/app.js",
    "#config/*": "./dist/src/config/*.js",
    "#controllers/*": "./dist/src/controllers/*.js",
    "#services/*": "./dist/src/services/*.js",
    "#routes/*": "./dist/src/routes/*.js",
    "#middlewares/*": "./dist/src/middlewares/*.js",
    "#utils/*": "./dist/src/utils/*.js",
    "#types/*": "./dist/src/types/*.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^6.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
