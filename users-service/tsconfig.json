{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "paths": {
      "#app": [
        "./app.ts"
      ],
      "#config/*": [
        "./src/config/*"
      ],
      "#models": [
        "./src/models/index.ts"
      ],
      "#models/*": [
        "./src/models/*"
      ],
      "#routes/*": [
        "./src/routes/*"
      ],
      "#controllers/*": [
        "./src/controllers/*"
      ],
      "#services/*": [
        "./src/services/*"
      ],
      "#middlewares/*": [
        "./src/middlewares/*"
      ],
      "#validators/*": [
        "./src/validators/*"
      ],
      "#repositories/*": [
        "./src/repositories/*"
      ],
      "#constants/*": [
        "./src/constants/*"
      ],
      "#utils/*": [
        "./src/utils/*"
      ],
      "#types/*": [
        "./src/types/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "server.ts",
    "app.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
